# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output and caches
# (.next/cache also holds the place-photo TTL probe log, see
# scripts/probe-place-photo-ttl.mjs)
/.next/
/out/
/build/
/next-env.d.ts
*.tsbuildinfo

# Tests and browser automation
/coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/
.playwright-mcp/

# Environment files. Only the template is committed.
.env*
!.env.example

# Keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Deployment
.vercel/

# Python (scripts/*.py and data/research/scripts/*.py)
__pycache__/
*.py[cod]
.venv/
venv/

# The Indic Parler generator writes .wav next to the shipped .mp3 narration;
# convert them and only commit the .mp3 (see the script header).
public/audio/**/*.wav

# OS and editor files
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json

# Local-only material that is never published: internal plans, operator
# scripts, and the large 3D source and reference photo sets.
# See _private/README.md.
/_private/
/reference/
/assets/
