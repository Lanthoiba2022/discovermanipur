# ──────────────────────────────────────────────────────────────────────────────
# Yening — environment variables
#
# Copy to `.env.local` and fill in. Every variable below is OPTIONAL for local
# development: with none of them set the app still builds, renders and runs —
# auth falls back to a clearly-labelled local demo session and the AI concierge
# degrades to a static response.
# ──────────────────────────────────────────────────────────────────────────────

# Neon (Lakebase Postgres) connection strings — Neon Console → Connect.
# SERVER ONLY. Pooled (host has `-pooler`) for app traffic; direct for
# `npm run db:migrate` and `npm run db:seed`. `neon env pull` writes both.
# When DATABASE_URL is missing, catalogue and content fall back to the bundled
# seed data.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth (Managed Better Auth) URL for the branch — Neon Console → Auth →
# Configuration, e.g. https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth
# SERVER ONLY: the browser talks to it through the same-origin /api/auth proxy.
NEON_AUTH_BASE_URL=

# Signs the app's cached session cookie. SERVER ONLY, 32+ characters:
#   openssl rand -base64 32
# When this or NEON_AUTH_BASE_URL is missing, auth falls back to the local
# demo session (next.config.ts derives the public NEXT_PUBLIC_AUTH_CONFIGURED
# flag from the pair — don't set that one yourself).
NEON_AUTH_COOKIE_SECRET=

# Anthropic API key for the AI travel concierge (Vercel AI SDK / Claude).
# SERVER ONLY — read inside route handlers under /api, never in the browser.
ANTHROPIC_API_KEY=

# Canonical public origin of this deployment, no trailing slash.
# Used for absolute URLs in metadata and sitemaps. Magic links come back to
# `<origin>/auth/callback`; every production origin must also be a trusted
# domain in Neon Auth (Console → Auth → Domains). Localhost is allowed.
# Local: http://localhost:3000   Production: https://yening.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MapTiler key for the Kangla 3D map at /explore/kangla. It reaches the browser
# by design, so the protection is the key's origin allowlist in the MapTiler
# console, not secrecy — list every origin you serve from, including the local
# dev port. /explore/kangla is prerendered, so changing this needs a rebuild.
# Nothing here uses Google Maps.
# Google Maps Platform key for the Kangla 3D map (/explore/kangla).
# Browser key: enable "Maps JavaScript API" and "Map Tiles API", restrict it by
# HTTP referrer to the origins this app is served from (include localhost:3000).
# It is passed to the client component as a prop, so it is public by design.
GOOGLE_API_KEY=

MAP_TILER_API_KEY=
