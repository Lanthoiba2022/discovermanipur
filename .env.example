# ──────────────────────────────────────────────────────────────────────────────
# Discover Manipur — environment variables
#
# Copy to `.env.local` and fill in what you need. Every variable is optional
# for local development: without them the app still builds and runs locally,
# serving the bundled seed catalogue, with browser-only local accounts and a
# sample concierge conversation. Production builds disable sign-in when Neon
# Auth is missing.
#
# SERVER ONLY variables must never be renamed with a NEXT_PUBLIC_ prefix or
# read from a client component. Placeholder values only — never commit real
# keys. `.env.local` is git-ignored.
# ──────────────────────────────────────────────────────────────────────────────


# ── Database (Neon Postgres) ─────────────────────────────────────────────────

# Pooled connection string (host contains `-pooler`): Neon Console → Connect.
# SERVER ONLY. Optional for the app: without it the catalogue and editorial
# content come from the bundled seed modules. Required by `npm run db:migrate`,
# `db:seed`, `db:studio` and `db:set-role`.
DATABASE_URL=


# ── Auth (Neon Auth) ─────────────────────────────────────────────────────────

# Neon Auth URL for the branch: Console → Auth → Configuration, e.g.
# https://ep-xxxx.neonauth.<region>.aws.neon.tech/neondb/auth
# SERVER ONLY: the browser talks to it through the same-origin /api/auth proxy.
NEON_AUTH_BASE_URL=

# Signs the session cookie. SERVER ONLY, 32+ characters:
#   openssl rand -base64 32
# Auth turns on only when this and NEON_AUTH_BASE_URL are both set.
# next.config.ts derives the public NEXT_PUBLIC_AUTH_CONFIGURED flag from the
# pair, so do not set that one yourself.
NEON_AUTH_COOKIE_SECRET=


# ── Email (Brevo) ────────────────────────────────────────────────────────────

# Delivers Neon Auth's verification codes: Neon Auth posts each code to
# /api/webhooks/neon-auth (the `send.otp` event) and that route sends it via
# Brevo. SERVER ONLY. Optional unless the webhook is enabled (see db/README.md).
# API key from Brevo → SMTP & API → API keys (an API key, not the SMTP key).
BREVO_API_KEY=
# A sender address verified in Brevo → Senders & Domains.
BREVO_SENDER_EMAIL=noreply@example.com
# Optional. Defaults to "Discover Manipur".
BREVO_SENDER_NAME=Discover Manipur

# Inbox for /contact form messages, sent through Brevo with Reply-To set to the
# visitor. SERVER ONLY. Optional: without it (or without Brevo) the form
# validates and tells the visitor nothing was sent. Use a shared project
# address, not a personal one.
CONTACT_INBOX_EMAIL=


# ── AI concierge ─────────────────────────────────────────────────────────────

# The concierge answers live only when AI_CHAT_ENABLED=true AND a provider key
# is set; otherwise /plan shows a sample conversation built from the catalogue.
AI_CHAT_ENABLED=false

# Google Gemini key (preferred provider). SERVER ONLY. Optional.
# GOOGLE_GENERATIVE_AI_API_KEY is accepted as an alias. Use a key restricted
# to the Generative Language API; GOOGLE_API_KEY is never used for Gemini.
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# Anthropic key, used only when no Gemini key is set. SERVER ONLY. Optional.
ANTHROPIC_API_KEY=


# ── Maps (Google Maps Platform) ──────────────────────────────────────────────

# Browser key for /explore/kangla, the Kangla 3D map. It is sent to the
# browser, so it is public by design: allow only "Maps JavaScript API" and
# "Map Tiles API", and restrict it by HTTP referrer to every origin you serve
# from (include http://localhost:3000). The page is prerendered, so changing
# the key needs a rebuild. Optional: without it the map shows a notice.
GOOGLE_API_KEY=

# Server key for /api/place-photo, which resolves Google Places photo
# references (Places API (New) only — no referrer restriction, it never reaches
# the browser). SERVER ONLY. Optional: falls back to GOOGLE_API_KEY, but a
# separate key keeps a leaked browser key from running up the Places bill.
# Also used by `npm run photos:ttl`.
GOOGLE_PLACES_API_KEY=


# ── Analytics ────────────────────────────────────────────────────────────────

# None. Vercel Analytics and Speed Insights need no variables; they report only
# when deployed on Vercel. Microsoft Clarity loads in production builds only;
# its project id is public and set in src/app/layout.tsx (change it in a fork).
